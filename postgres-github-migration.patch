-    {
-      extensions: [StarterKit, Image, Typography, Underline],
-      content,
-      editable: false,
-      editorProps: {
-        attributes: {
-          class:
-            'prose prose-lg max-w-none font-mono ' +
-            'prose-headings:font-serif prose-headings:text-ink ' +
-            'prose-p:text-ink-light prose-p:leading-relaxed ' +
